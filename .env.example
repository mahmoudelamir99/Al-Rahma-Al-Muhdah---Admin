# نموذج للإعدادات — انسخه إلى .env.local واملأ القيم
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# رابط الموقع الأساسي — زرار "زيارة الموقع" والـ revalidate webhook بيعتمدوا عليه.
# على Vercel حطّه على رابط الدومين الحقي، مثال: https://alrahma.com
# لازم يبدأ بـ NEXT_PUBLIC_ عشان يوصل للمتصفح.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# سر الـ webhook (اختياري لكن مستحسن على الإنتاج).
# لازم يكون نفس القيمة في مشروع الموقع الأساسي.
SITE_REVALIDATE_SECRET=
